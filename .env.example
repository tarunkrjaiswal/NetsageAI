# Copy to .env for local development. Never commit .env or real credentials.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MOCK_AI=false
SECRET_KEY=
FLASK_DEBUG=true
PORT=5000
MAX_CONTENT_LENGTH=1048576
# Keep false for public deployments; set true only for trusted/local use.
EXPOSE_DIAGNOSIS_INPUTS=false

# Leave DATABASE_URL empty to use local SQLite.
# For Supabase, use the Session Pooler connection string (recommended for hosted apps).
DATABASE_URL=
# Optional; used only for SQLite.
SQLITE_PATH=database/netsage.db
# PostgreSQL pool bounds for Render/Gunicorn (only used when DATABASE_URL is PostgreSQL).
PG_POOL_MIN=1
PG_POOL_MAX=4
